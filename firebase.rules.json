{
  "rules": {
    ".read": false,
    ".write": false,
    "adminWhitelist": {
      ".read": "auth != null",
      ".write": "auth.uid === 'Uks9YGSd6rS40zqlRujoe6pE6N22' || (auth != null && root.child('adminWhitelist/approved').child(auth.uid).exists())",
      "approved": {
        "$uid": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      },
      "pending": {
        ".read": "auth != null && root.child('adminWhitelist/approved').child(auth.uid).exists()",
        ".write": "auth.uid === 'Uks9YGSd6rS40zqlRujoe6pE6N22' || (auth != null && root.child('adminWhitelist/approved').child(auth.uid).exists())",
        "$emailKey": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "beats": {
      ".read": true,
      ".write": "auth != null && (root.child('adminWhitelist/approved').child(auth.uid).exists() || auth.token.firebase.sign_in_provider == 'anonymous')",
      ".indexOn": [
        "genre",
        "date",
        "order",
        "active",
        "featured",
        "exclusive",
        "available",
        "deleted"
      ],
      "$beatId": {
        ".validate": "newData.hasChildren(['name', 'genre', 'bpm', 'key'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "genre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "bpm": {
          ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 400"
        },
        "key": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "plays": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "licenses": {
          "$idx": {
            ".validate": "newData.hasChildren(['name'])",
            "$field": {
              ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
            }
          }
        },
        "$field": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
        }
      }
    },
    "kits": {
      ".read": true,
      ".write": "auth != null && (root.child('adminWhitelist/approved').child(auth.uid).exists() || auth.token.firebase.sign_in_provider == 'anonymous')",
      ".indexOn": [
        "genre",
        "active",
        "order"
      ],
      "$kitId": {
        ".validate": "newData.hasChildren(['name', 'genre', 'priceMXN', 'priceUSD'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "description": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
        },
        "genre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "imageUrl": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
        },
        "priceMXN": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "priceUSD": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "order": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "samples": {
          "$idx": {
            ".validate": "newData.hasChildren(['name', 'url'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "duration": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
            }
          }
        },
        "$field": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
        }
      }
    },
    "users": {
      ".read": true,
      ".indexOn": [
        "username"
      ],
      "$uid": {
        ".write": "auth !== null && (auth.uid === $uid || root.child('adminWhitelist/approved').child(auth.uid).exists())",
        "username": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[a-z0-9_-]+$/))"
        },
        "bio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 160)"
        },
        "artistName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
        },
        "banned": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "badges": {
          "$badge": {
            ".validate": "newData.isString()"
          }
        },
        "$field": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
        }
