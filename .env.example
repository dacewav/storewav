# Firebase — copia este archivo a .env y rellena con tus credenciales
# Obtén los valores en: https://console.firebase.google.com → Project Settings → General → Your apps → Web app
#
# En Cloudflare Pages: configura estas mismas vars en el dashboard (Build → Environment variables)
# Son PUBLIC_* → se inlinen en el bundle en build time (no runtime secrets)

PUBLIC_FIREBASE_API_KEY=AIzaSyCr2dekkLLifIg0_JlLfEleaV32b5XdvIQ
PUBLIC_FIREBASE_AUTH_DOMAIN=dacewav-store-3b0f5.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://dacewav-store-3b0f5-default-rtdb.firebaseio.com
PUBLIC_FIREBASE_PROJECT_ID=dacewav-store-3b0f5
PUBLIC_FIREBASE_STORAGE_BUCKET=dacewav-store-3b0f5.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=163354805352
PUBLIC_FIREBASE_APP_ID=1:163354805352:web:d8a99d1d71323de1ed27dd

# Google One Tap — OAuth 2.0 Client ID (Web application)
# Obtener en: Firebase Console → Authentication → Sign-in method → Google → Web client ID
# O en: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
PUBLIC_GOOGLE_CLIENT_ID=163354805352-v4jmd8qnck443j2qca4t405c0ciem9h3.apps.googleusercontent.com

# Admin UIDs — comma-separated Firebase UIDs that get admin access
# Obtener UID: login en /login → copiar UID que muestra la página
PUBLIC_ADMIN_UIDS=Uks9YGSd6rS40zqlRujoe6pE6N22

# R2 Presigned URLs — for secure expiring download links
# Crear en: https://dash.cloudflare.com/?to=/:account/r2/overview → Manage API Tokens
# Estas son runtime secrets (no PUBLIC_*) → configurar en Cloudflare Pages como Environment variables
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Stripe — payment processing
# Obtener en: https://dashboard.stripe.com/apikeys
# Runtime secret → configurar en Cloudflare Pages como Environment variable
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email delivery
# Obtener en: https://resend.com/api-keys
# Runtime secret → configurar en Cloudflare Pages como Environment variable
RESEND_API_KEY=
